#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.profile-tst.xcconfig"
#include "Generated.xcconfig"

ASSET_PREFIX=tst
BUNDLE_NAME=Edubadges Tst
BUNDLE_DISPLAY_NAME=Edubadges Tst
BASE_URL=https://api-demo.edubadges.nl

// APNs environment. Archives are signed with a distribution profile, which
// carries aps-environment=production; requesting "development" here makes Xcode
// demand a development certificate and fails the archive.
APS_ENVIRONMENT=production
